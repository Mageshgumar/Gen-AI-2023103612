from googletrans import Translator

translator = Translator()

text = input("Enter text to translate: ")
src_lang = input("Enter source language (e.g., 'en'): ")
target_lang = input("Enter target language (e.g., 'fr'): ")

translated = translator.translate(text, src=src_lang, dest=target_lang)

print(f"\nOriginal ({src_lang}): {text}")
print(f"Translated ({target_lang}): {translated.text}")
